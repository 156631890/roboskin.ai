{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": true
  },
  "headers": [
    {
      "source": "/feed.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/rss+xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/news-sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/physics-ai",
      "destination": "https://roboskin.ai/physical-ai",
      "statusCode": 301
    },
    {
      "source": "/applications/humanoid-robot-skin",
      "destination": "https://roboskin.ai/humanoid-robot-skin",
      "permanent": true
    },
    {
      "source": "/guides/tactile-foundation-models",
      "destination": "https://roboskin.ai/tactile-foundation-models",
      "permanent": true
    },
    {
      "source": "/guides/tactile-datasets-robot-learning",
      "destination": "https://roboskin.ai/datasets",
      "permanent": true
    },
    {
      "source": "/guides/physical-ai-touch-data",
      "destination": "https://roboskin.ai/physical-ai-touch",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.roboskin.ai"
        }
      ],
      "destination": "https://roboskin.ai",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.roboskin.ai"
        }
      ],
      "destination": "https://roboskin.ai/:path*",
      "permanent": true
    }
  ]
}
