{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": true
  },
  "buildCommand": "npm run build",
  "routes": [
    {
      "src": "/physics-ai",
      "status": 301,
      "headers": {
        "Location": "https://roboskin.ai/physical-ai"
      }
    },
    {
      "src": "/applications/humanoid-robot-skin",
      "status": 308,
      "headers": {
        "Location": "https://roboskin.ai/humanoid-robot-skin"
      }
    },
    {
      "src": "/guides/tactile-foundation-models",
      "status": 308,
      "headers": {
        "Location": "https://roboskin.ai/tactile-foundation-models"
      }
    },
    {
      "src": "/guides/tactile-datasets-robot-learning",
      "status": 308,
      "headers": {
        "Location": "https://roboskin.ai/datasets"
      }
    },
    {
      "src": "/guides/physical-ai-touch-data",
      "status": 308,
      "headers": {
        "Location": "https://roboskin.ai/physical-ai-touch"
      }
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "www.roboskin.ai"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://roboskin.ai"
      }
    },
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": "www.roboskin.ai"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://roboskin.ai/$1"
      }
    },
    {
      "src": "/feed\\.xml",
      "headers": {
        "Content-Type": "application/rss+xml; charset=utf-8"
      },
      "continue": true
    },
    {
      "src": "/news-sitemap\\.xml",
      "headers": {
        "Content-Type": "application/xml; charset=utf-8"
      },
      "continue": true
    },
    {
      "src": "^/(?:$|(?!_next/|_vercel/|api/|_agent-markdown/)(?!.*\\.[^/]+$).*)$",
      "headers": {
        "Vary": "Accept, Accept-Encoding"
      },
      "continue": true
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "^\\s*text/markdown(?:\\s*;\\s*q=(?:1(?:\\.0+)?|0?\\.(?:\\d*[1-9]\\d*)))?(?:\\s*,.*)?$"
        }
      ],
      "dest": "/_agent-markdown/index.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept, Accept-Encoding",
        "Cache-Control": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400",
        "X-Content-Type-Options": "nosniff"
      }
    },
    {
      "src": "^/((?!_next/|_vercel/|api/|_agent-markdown/)(?!.*\\.[^/]+$).+?)/?$",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "^\\s*text/markdown(?:\\s*;\\s*q=(?:1(?:\\.0+)?|0?\\.(?:\\d*[1-9]\\d*)))?(?:\\s*,.*)?$"
        }
      ],
      "dest": "/_agent-markdown/$1.md",
      "headers": {
        "Content-Type": "text/markdown; charset=utf-8",
        "Vary": "Accept, Accept-Encoding",
        "Cache-Control": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400",
        "X-Content-Type-Options": "nosniff"
      }
    },
    {
      "src": "/robots\\.txt",
      "dest": "/crawler-robots.txt",
      "missing": [
        {
          "type": "header",
          "key": "rsc"
        }
      ],
      "headers": {
        "Content-Type": "text/plain; charset=utf-8",
        "Cache-Control": "public, max-age=3600"
      }
    }
  ]
}
